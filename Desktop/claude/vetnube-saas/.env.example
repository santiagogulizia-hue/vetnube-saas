# Copiá este archivo como .env.local y completá los valores.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
# service_role: SOLO servidor (webhook de facturación). Nunca la publiques ni la uses con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Mercado Pago → Tus integraciones → tu aplicación → Credenciales
# Usá las credenciales de PRUEBA (TEST-...) mientras desarrollás.
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxx-000000000
# Tus integraciones → Webhooks → "Clave secreta" (valida que las notificaciones vengan de Mercado Pago)
MERCADOPAGO_WEBHOOK_SECRET=tu-clave-secreta-del-webhook

# URL pública de la app (https). Mercado Pago la usa para el regreso del checkout y los webhooks.
# En local, usá un túnel (ngrok / cloudflared) o tu dominio de Vercel.
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
